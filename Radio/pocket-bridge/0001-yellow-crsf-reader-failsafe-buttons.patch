diff --git a/src/utils/CrsfReader.cpp b/src/utils/CrsfReader.cpp
new file mode 100644
index 0000000..cd17ff9
--- /dev/null
+++ b/src/utils/CrsfReader.cpp
@@ -0,0 +1,75 @@
+#include "CrsfReader.h"
+
+// CRSF frame: [address][length][type][payload...][crc8]
+// length counts type + payload + crc; crc8 (DVB-S2, poly 0xD5) covers type + payload.
+#define CRSF_ADDRESS_FLIGHT_CONTROLLER 0xC8  // what an ELRS receiver addresses its output to
+#define CRSF_TYPE_RC_CHANNELS 0x16
+#define CRSF_RC_FRAME_LENGTH 24              // type + 22 bytes of 11-bit channels + crc
+#define CRSF_MAX_FRAME_LENGTH 62
+// Frames arrive with idle time between them; a pause this long mid-frame means we
+// were not really in a frame. Well above one byte (87 us at 115200).
+#define CRSF_GAP_US 2000
+
+static uint8_t crc8_dvb_s2(const uint8_t *data, uint8_t len) {
+    uint8_t crc = 0;
+    for (uint8_t i = 0; i < len; i++) {
+        crc ^= data[i];
+        for (uint8_t bit = 0; bit < 8; bit++) {
+            crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ 0xD5) : (uint8_t)(crc << 1);
+        }
+    }
+    return crc;
+}
+
+bool CrsfReader::feed(uint8_t b, uint32_t now_us) {
+    if (pos > 0 && (uint32_t)(now_us - last_byte_us) > CRSF_GAP_US) {
+        pos = 0;
+    }
+    last_byte_us = now_us;
+
+    if (pos == 0) {
+        if (b == CRSF_ADDRESS_FLIGHT_CONTROLLER) {
+            buf[pos++] = b;
+        }
+        return false;
+    }
+    if (pos == 1) {
+        if (b < 2 || b > CRSF_MAX_FRAME_LENGTH) {
+            pos = 0;
+            return false;
+        }
+        buf[pos++] = b;
+        return false;
+    }
+
+    buf[pos++] = b;
+    uint8_t length = buf[1];
+    if (pos < length + 2) {
+        return false;
+    }
+    pos = 0;
+
+    if (crc8_dvb_s2(&buf[2], length - 1) != buf[length + 1]) {
+        crc_errors++;
+        return false;
+    }
+    if (buf[2] != CRSF_TYPE_RC_CHANNELS || length != CRSF_RC_FRAME_LENGTH) {
+        return false;  // a valid frame of another type, e.g. link statistics
+    }
+
+    // 16 channels x 11 bits, little-endian, packed into the 22-byte payload.
+    const uint8_t *payload = &buf[3];
+    uint32_t bits = 0;
+    uint8_t nbits = 0;
+    uint8_t byte_index = 0;
+    for (uint8_t ch = 0; ch < CRSF_NUM_CHANNELS; ch++) {
+        while (nbits < 11) {
+            bits |= (uint32_t)payload[byte_index++] << nbits;
+            nbits += 8;
+        }
+        channels[ch] = bits & 0x07FF;
+        bits >>= 11;
+        nbits -= 11;
+    }
+    return true;
+}
diff --git a/src/utils/CrsfReader.h b/src/utils/CrsfReader.h
new file mode 100644
index 0000000..ed25eb3
--- /dev/null
+++ b/src/utils/CrsfReader.h
@@ -0,0 +1,23 @@
+// CrsfReader.h
+// Byte-at-a-time CRSF frame reader. Accepts only RC-channel frames (type 0x16)
+// whose CRC8 matches, and drops back to hunting for a frame start after any bad
+// byte or an idle gap, so one corrupted frame can't shift every frame after it.
+#pragma once
+#include <stdint.h>
+
+#define CRSF_NUM_CHANNELS 16
+
+class CrsfReader {
+    public:
+        // Feed one received byte; now_us is micros() at read time.
+        // Returns true when a valid RC-channels frame has just completed.
+        bool feed(uint8_t b, uint32_t now_us);
+
+        uint16_t channels[CRSF_NUM_CHANNELS];  // raw CRSF values, 172..1811
+        uint16_t crc_errors = 0;
+
+    private:
+        uint8_t buf[64];
+        uint8_t pos = 0;
+        uint32_t last_byte_us = 0;
+};
diff --git a/test/test_crsf_reader.cpp b/test/test_crsf_reader.cpp
new file mode 100644
index 0000000..753698b
--- /dev/null
+++ b/test/test_crsf_reader.cpp
@@ -0,0 +1,72 @@
+// Host test for CrsfReader: c++ -std=c++11 -Isrc test/test_crsf_reader.cpp src/utils/CrsfReader.cpp
+#include <cassert>
+#include <cstdio>
+#include <vector>
+#include "utils/CrsfReader.h"
+
+static uint8_t crc8(const std::vector<uint8_t> &d, size_t from) {
+    uint8_t crc = 0;
+    for (size_t i = from; i < d.size(); i++) {
+        crc ^= d[i];
+        for (int b = 0; b < 8; b++) crc = (crc & 0x80) ? ((crc << 1) ^ 0xD5) : (crc << 1);
+    }
+    return crc;
+}
+
+static std::vector<uint8_t> rc_frame(const uint16_t ch[16]) {
+    std::vector<uint8_t> f = {0xC8, 24, 0x16};
+    uint32_t bits = 0; int nbits = 0;
+    for (int i = 0; i < 16; i++) {
+        bits |= (uint32_t)(ch[i] & 0x7FF) << nbits; nbits += 11;
+        while (nbits >= 8) { f.push_back(bits & 0xFF); bits >>= 8; nbits -= 8; }
+    }
+    f.push_back(crc8(f, 2));
+    return f;
+}
+
+static std::vector<uint8_t> link_stats_frame() {
+    std::vector<uint8_t> f = {0xC8, 12, 0x14, 50, 50, 100, 5, 0, 2, 1, 50, 100, 5};
+    f.push_back(crc8(f, 2));
+    return f;
+}
+
+struct Feeder {
+    CrsfReader r; uint32_t t = 0; int frames = 0;
+    void bytes(const std::vector<uint8_t> &v) { for (uint8_t b : v) { t += 87; if (r.feed(b, t)) frames++; } }
+    void gap(uint32_t us) { t += us; }
+};
+
+int main() {
+    uint16_t ch[16];
+    for (int i = 0; i < 16; i++) ch[i] = 172 + i * 100;  // distinct values across the range
+    ch[0] = 992; ch[15] = 1811;
+    auto frame = rc_frame(ch);
+    assert(frame.size() == 26);
+
+    // 1. One clean frame decodes every channel exactly.
+    { Feeder f; f.bytes(frame);
+      assert(f.frames == 1);
+      for (int i = 0; i < 16; i++) assert(f.r.channels[i] == ch[i]); }
+
+    // 2. Joining mid-frame: the partial frame is dropped, the next one decodes.
+    { Feeder f; f.bytes(std::vector<uint8_t>(frame.begin() + 7, frame.end())); f.gap(4000); f.bytes(frame);
+      assert(f.frames == 1); assert(f.r.channels[5] == ch[5]); }
+
+    // 3. A corrupted byte fails the CRC and is never reported; the next frame is fine.
+    { Feeder f; auto bad = frame; bad[10] ^= 0x01; f.bytes(bad); f.gap(4000); f.bytes(frame);
+      assert(f.frames == 1); assert(f.r.crc_errors == 1); assert(f.r.channels[3] == ch[3]); }
+
+    // 4. Link-statistics frames back to back with RC frames are skipped, not misread.
+    { Feeder f; for (int i = 0; i < 20; i++) { f.bytes(frame); f.bytes(link_stats_frame()); }
+      assert(f.frames == 20); assert(f.r.crc_errors == 0); }
+
+    // 5. A stray 0xC8 in line noise before a frame doesn't swallow it (the gap resets).
+    { Feeder f; f.bytes({0x00, 0xC8, 0x30, 0x11}); f.gap(4000); f.bytes(frame);
+      assert(f.frames == 1); }
+
+    // 6. Back-to-back RC frames with no gap all decode.
+    { Feeder f; for (int i = 0; i < 50; i++) f.bytes(frame); assert(f.frames == 50); }
+
+    puts("crsf reader: all 6 cases pass");
+    return 0;
+}
